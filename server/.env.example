# Copy to `.env` and adjust. `.env` is gitignored; this template is not.
#
#     cp .env.example .env
#
# Resolution order:  CLI positional arg (port only)  >  process environment
#                    >  this file  >  built-in default
#
# Real environment variables win over this file, so a one-off override works:
#     PORT=3000 dart run bin/server.dart
#
# There are no secrets here, and there is no API key anywhere in this project —
# the map basemap comes from the 內政部國土測繪中心 WMTS service, which needs
# no account. If you ever find yourself adding a credential to this file,
# read CONTRIBUTING.md first.

# HTTP port. A positional argument beats this: dart run bin/server.dart 3000
PORT=8080

# The coordinate table. This file IS committed to the repo — the Taipei
# OpenData dataset carries no 座標x/座標y at all, so this is the only source of
# coordinates in the entire system. Point this elsewhere only if you have built
# your own table.
#
# Rebuild it with:  dart run tool/build_coordinates.dart --overpass --report
COORDINATES_CSV=data/shelter_coordinates.csv

# How long an upstream fetch stays fresh, in seconds. The dataset is
# republished a few times a year, so this is generous; the point is to stop
# re-downloading all 401 records on every single request.
CACHE_TTL_SECONDS=600

# debug | info | warn | error
# Logs go to logs/server.log, which is gitignored and may contain user queries
# and IP addresses — treat it as sensitive.
LOG_LEVEL=info
