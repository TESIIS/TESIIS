# Copy to `.env` and adjust. `.env` is gitignored; this template is not.
#
#     cp .env.example .env
#
# Resolution order:  CLI positional arg (port only)  >  process environment
#                    >  this file  >  built-in default
#
# Real environment variables win over this file, so a one-off override works:
#     PORT=3000 dart run bin/server.dart
#
# There is no API key required to run this system — the map basemap comes
# from the 內政部國土測繪中心 WMTS service and the shelter data comes from
# 消防署's open point file, neither needs an account. TDX (below) is optional
# and is the only credential this project has anywhere. If you ever find
# yourself adding another one, read CONTRIBUTING.md first.

# HTTP port. A positional argument beats this: dart run bin/server.dart 3000
PORT=8080

# The nationwide shelter snapshot. This file IS committed to the repo — it's
# the floor the server falls back to when the live NFA fetch is unavailable
# or looks implausible. Point this elsewhere only if you have built your own.
#
# Rebuild it with:  dart run tool/build_nationwide_snapshot.dart --report
SNAPSHOT_CSV=data/shelters_nationwide.csv

# How long an upstream fetch stays fresh, in seconds. The dataset is
# republished periodically, so this is generous; the point is to stop
# re-downloading ~6,000 records on every single request.
CACHE_TTL_SECONDS=600

# debug | info | warn | error
# Logs go to logs/server.log, which is gitignored and may contain user queries
# and IP addresses — treat it as sensitive.
LOG_LEVEL=info

# Overrides where 消防署避難收容處所點位檔 is fetched from. Only set this if
# your deployment's egress IP has trouble reaching the default host.
# NFA_POINT_FILE_URL=https://opdadm.moi.gov.tw/api/v1/no-auth/resource/api/dataset/ED6CF735-6C03-4573-A882-72C1BEC799CB/resource/54550E2F-4567-4C8F-BD2E-E54E9D0386B8/download

# Overrides where 臺北市可供避難收容處所一覽表 is fetched from (used only by
# tool/build_coordinates.dart's Taipei-only cross-check, not at runtime).
# UPSTREAM_BASE_URL=https://data.taipei/api/v1/dataset

# ── TDX (optional) ────────────────────────────────────────────────────────
# Leave both blank and the /api/transit/* endpoints return 503 with
# {"available": false}. Nothing else in the system is affected — no shelter
# endpoint imports the TDX client. Register at https://tdx.transportdata.tw/ .
# These credentials live ONLY on the server — never in the Flutter bundle,
# never in git. See CONTRIBUTING.md's 禁止提交清單.
# TDX_CLIENT_ID=
# TDX_CLIENT_SECRET=
TDX_TIMEOUT_SECONDS=5
