# ====== 環境與機敏資料 ======
.env
.env.local
.env*.local
# Templates carry no secrets and must stay in version control.
!.env.example

# 金鑰、憑證、簽章檔（見 CONTRIBUTING.md 的「禁止提交清單」）
*.keystore
*.jks
*.p12
*.pem
*.mobileprovision
**/google-services.json
**/GoogleService-Info.plist
**/local.properties
service-account*.json

# Flutter Web 執行期設定（可能含金鑰）
flutter_codefest/web/env.js

# ====== 開發工具與 IDE ======
.vscode/
.idea/
*.iml
*.ipr
*.iws
.atom/
.svn/

# ====== 虛擬環境 ======
.venv/
venv/

# ====== 作業系統 ======
.DS_Store
Thumbs.db

# ====== 日誌 ======
